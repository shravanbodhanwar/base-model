# =============================================================
# BEL-EDIDAP Environment Variables
# Copy this file to .env in apps/api and apps/web directories
# =============================================================

# ── DATABASE ──────────────────────────────────────────────────
POSTGRES_USER=bel_admin
POSTGRES_PASSWORD=bel_secure_pass
POSTGRES_DB=bel_edidap
DATABASE_URL="postgresql://bel_admin:bel_secure_pass@localhost:5432/bel_edidap"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── BACKEND ───────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── BLOCKCHAIN ────────────────────────────────────────────────
# Local Hardhat node (change for testnet deployment)
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CHAIN_ID=31337

# Deployer private key from Hardhat's built-in test accounts
# NEVER use a real private key here — these are Hardhat test keys only
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract addresses (populated after deployment)
CONTRACT_IDENTITY_REGISTRY=
CONTRACT_ORG_REGISTRY=
CONTRACT_ROLE_REGISTRY=
CONTRACT_CREDENTIAL_REGISTRY=
CONTRACT_ASSET_NFT=
CONTRACT_AUDIT_REGISTRY=
CONTRACT_GOVERNANCE=

# ── FRONTEND ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:8545
NEXT_PUBLIC_APP_NAME="BEL-EDIDAP"
NEXT_PUBLIC_APP_ENV=DEMO

# ── SECURITY ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── QR CODE ───────────────────────────────────────────────────
# Public-facing URL for QR verification links
PUBLIC_VERIFIER_URL=http://localhost:3000

# ── MULTISIG ──────────────────────────────────────────────────
MULTISIG_THRESHOLD=2
MULTISIG_TOTAL_SIGNERS=3
